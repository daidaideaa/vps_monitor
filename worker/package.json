{
  "name": "vps-monitor-tokyo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js ../tests/frontend.test.cjs && npm run test:runtime",
    "test:runtime": "workerd test test/runtime.capnp",
    "test:probe-rfchost": "node --test test/rfchost-probe.test.js",
    "probe:rfchost": "node scripts/probe-rfchost.mjs",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "node scripts/deploy.mjs",
    "logs": "wrangler tail"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "wrangler": "4.135.0"
  }
}
