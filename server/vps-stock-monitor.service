[Unit]
Description=Query ZgoCloud and RFCHOST stock on Hong Kong VPS
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=vmiss-monitor
Group=vmiss-monitor
WorkingDirectory=/opt/vmiss-public-status
ExecStart=/opt/vmiss-stock-monitor/.venv/bin/python /opt/vmiss-public-status/vps_stock_monitor.py --once
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/vmiss-stock-monitor/.browsers
Environment=PYTHONUNBUFFERED=1
StateDirectory=vps-stock-monitor
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=150
KillMode=control-group
MemoryMax=300M
MemorySwapMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vps-stock-monitor
