{
  "name": "vps-monitor",
  "main": "public-edge.mjs",
  "account_id": "b8df9390d0a7639d399e7f3aaeea589d",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "build": {"command": "node scripts/build_public.mjs"},
  "observability": {"enabled": false},
  "assets": {"directory": ".local/public-site", "binding": "ASSETS", "run_worker_first": ["/api/*"]}
}
